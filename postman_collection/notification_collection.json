{
	"info": {
		"name": "Telemedicine - Notification & Feedback API",
		"description": "Collection สำหรับทดสอบระบบแจ้งเตือนและประเมินผล",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Notifications",
			"item": [
				{
					"name": "Get Notifications",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Response contains data array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/notification",
							"host": ["{{base_url}}"],
							"path": ["api", "notification"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Feedback",
			"item": [
				{
					"name": "Submit Feedback",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 or 200', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"user_id\": 1,\n    \"doctor_id\": 1,\n    \"rating\": 4.5,\n    \"comment\": \"บริการดีมากครับ ให้คำแนะนำชัดเจน\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/feedback",
							"host": ["{{base_url}}"],
							"path": ["api", "feedback"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Admin Panel",
			"item": [
				{
					"name": "Verify Doctor",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Successfully updated', function () { pm.response.to.have.status(200); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"is_verified\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/verify-doctor/1",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "verify-doctor", "1"]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080"
		}
	]
}