	"item": [
		{
			"name": "Create Slot",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"// Save id ลง variable เพื่อใช้ใน Delete",
							"var jsonData = pm.response.json();",
							"if (jsonData.data && jsonData.data.id) {",
							"    pm.collectionVariables.set(\"last_slot_id\", jsonData.data.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"start_time\": \"2026-06-01 09:00\",\n    \"end_time\": \"2026-06-01 10:00\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/doctor/1/slots",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"doctor",
						"1",
						"slots"
					]
				},
				"description": "แพทย์สร้าง slot ที่ว่าง"
			},
			"response": []
		},
